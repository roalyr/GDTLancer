[gd_scene format=2]

[node name="Row" type="PanelContainer"]
theme_type_variation = "StoreRow"

[node name="Row" type="HBoxContainer" parent="."]
custom_constants/separation = 8

[node name="Text" type="VBoxContainer" parent="Row"]
size_flags_horizontal = 3
custom_constants/separation = 0

[node name="Name" type="Label" parent="Row/Text"]
clip_text = true

[node name="Detail" type="Label" parent="Row/Text"]
theme_type_variation = "NoteLabel"
autowrap = true

# Classifies every preset under database/presets/ (PresetClassifier: role, family, weight class,
# temperament, traits; again each run, so a change to the rules reaches them all), saving it on each
# AgentTemplate, and writes database/presets/CATALOG.md: the
# designs by family and weight class, for picking archetypes when building factions. Presets keep
# their hull, fit and behaviour together; this only labels them. The same design in several draft
# folders is listed once (its lives and fitness from the folder where they are known).
#     godot --no-window -s tools/classify_presets.gd
extends SceneTree

var PresetClassifier = null  # Loaded at run time: they use autoloads, not there yet when this parses
var PresetExporter = null
const ROOT = "res://database/presets"
const Consts = preload("res://src/autoload/Constants.gd")


func _initialize():
	call_deferred("_run")


func _run():
	PresetClassifier = load("res://src/core/evolution/preset_classifier.gd")
	PresetExporter = load("res://src/core/evolution/preset_exporter.gd")
	var indexer = load("res://src/scenes/game_world/world_manager/template_indexer.gd").new()
	root.add_child(indexer)
	indexer.index_all_templates()  # The presets' parts, which roles are read from
	var designs := {}  # Ship id -> {agent, folder, proven}
	for path in _agent_files(ROOT):
		var agent = load(path)
		var folder: String = path.get_base_dir().get_file()
		var ship_path: String = path.get_base_dir().plus_file(agent.ship_template_id + ".tres")
		var ship = load(ship_path) if File.new().file_exists(ship_path) else null
		if ship == null:
			print("CLASSIFY no ship for ", path)
			continue
		PresetExporter.apply_classification(agent, PresetClassifier.classify(ship, agent.behavior, agent.role))  # The exporter's role (from the genome) stands
		ResourceSaver.save(path, agent)
		var known: Dictionary = designs.get(agent.ship_template_id, {})
		if known.empty() or (int(known.agent.lives) == 0 and agent.lives > 0):
			designs[agent.ship_template_id] = {"agent": agent, "ship": ship, "folder": folder, "proven": folder.ends_with("min10") or known.get("proven", false)}
		elif folder.ends_with("min10"):
			known.proven = true
	_write_catalog(designs)
	print("CLASSIFY %d designs -> %s/CATALOG.md" % [designs.size(), ROOT])
	quit()


func _agent_files(path: String) -> Array:
	var found: Array = []
	var dir := Directory.new()
	if dir.open(path) != OK:
		return found
	dir.list_dir_begin(true, true)
	var name: String = dir.get_next()
	while name != "":
		if dir.current_is_dir():
			found += _agent_files(path.plus_file(name))
		elif name.begins_with("agent_preset_") and name.ends_with(".tres"):
			found.append(path.plus_file(name))
		name = dir.get_next()
	return found


func _write_catalog(designs: Dictionary) -> void:
	var by_family := {}
	for ship_id in designs:
		var agent = designs[ship_id].agent
		if not by_family.has(agent.family):
			by_family[agent.family] = []
		by_family[agent.family].append(designs[ship_id])
	var lines: Array = [
		"# Preset catalog",
		"",
		"Generated by `tools/classify_presets.gd` from the presets in this folder: every exported design, by family and weight class, for picking archetypes when building factions. Hull, fit and pilot behaviour stay together in each preset; the columns only describe it.",
		"",
		"- **Temperament**: how readily its pilot starts, keeps up and chases fights against how soon it runs.",
		"- **Traits**: genes that went most of the way from where evolution started to an end of their range.",
		"- **Equipment / modules**: the fit it evolved with (the store sells the hull bare and these parts apart). **Hull WP**: the bare hull's price.",
		"- **Proven**: flew 10 lives or more. **Lives / fitness**: when exported (blank: exported before these were kept). Fitness is return on cost, less 1 for a lost ship; combat roles add the enemy value they destroyed.",
		"- The ship file is `preset_ship_<id>.tres`, the pilot `agent_preset_<id>.tres`, in the folder named.",
		"",
	]
	var families: Array = by_family.keys()
	families.sort()
	for family in families:
		lines.append("## %s" % family.capitalize())
		lines.append("")
		for weight in Consts.PRESET_WEIGHT_CLASSES:
			var rows: Array = []
			for design in by_family[family]:
				if design.agent.weight_class == weight[0]:
					rows.append(design)
			if rows.empty():
				continue
			rows.sort_custom(self, "_better_first")
			lines.append("### %s" % weight[0].capitalize())
			lines.append("")
			lines.append("| Design | Role | Temperament | Traits | Equipment | Modules | Proven | Lives | Fitness | Hull WP | Folder |")
			lines.append("|---|---|---|---|---|---|---|---|---|---|---|")
			for design in rows:
				var agent = design.agent
				lines.append("| %s | %s | %s | %s | %s | %s | %s | %s | %s | %d | %s |" % [
					agent.ship_template_id.replace("preset_ship_", ""), agent.role, agent.temperament, PoolStringArray(agent.traits).join(", "),
					_parts(design.ship.equipped_tools), _parts(design.ship.equipped_modules), "yes" if design.proven else "", str(agent.lives) if agent.lives > 0 else "", ("%+.2f" % agent.fitness) if agent.lives > 0 else "",
					design.ship.base_value, design.folder])
			lines.append("")
	var file := File.new()
	file.open(ROOT.plus_file("CATALOG.md"), File.WRITE)
	file.store_string(PoolStringArray(lines).join("\n"))
	file.close()


# Part names, a repeated one counted ("Laser II x2").
func _parts(ids: Array) -> String:
	var counts := {}
	var order: Array = []
	for part_id in ids:
		var part = root.get_node("TemplateDatabase").get_template(str(part_id))
		var name: String = str(part_id)
		if part != null:  # Class names unknown when this parses: read the fields
			name = str(part.get("tool_name") if part.get("tool_name") != null else part.get("module_name"))
		if not counts.has(name):
			order.append(name)
		counts[name] = int(counts.get(name, 0)) + 1
	var words: Array = []
	for name in order:
		words.append(name if counts[name] == 1 else "%s x%d" % [name, counts[name]])
	return PoolStringArray(words).join(", ")


func _better_first(a: Dictionary, b: Dictionary) -> bool:
	if a.proven != b.proven:
		return a.proven
	if (a.agent.lives > 0) != (b.agent.lives > 0):
		return a.agent.lives > 0
	return a.agent.fitness > b.agent.fitness
